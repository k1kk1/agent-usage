# Copy this file to agent-status.env and edit only the lines you need.
# You can also run ./install.sh to create it interactively.
#
# cp agent-status.env.example agent-status.env

# Pane layout. Use 10-16 for narrow cmux panes.
AGENT_STATUS_BAR_WIDTH=12

# Polling intervals.
AGENT_STATUS_INTERVAL_SECONDS=60
AGENT_STATUS_PANE_REFRESH_SECONDS=3
